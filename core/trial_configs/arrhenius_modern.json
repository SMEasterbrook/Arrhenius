{
    "title": "Modern replication of Arrhenius model with x2 CO2",
    "description": "A replication of Arrhenius original model for doubled CO2 using modern infrared absorbance data for greenhouse gases",
    "co2": {
        "from": 1,
        "to": 2
    },
    "year": 1895,
    "grid": {
        "dims": {
            "lat": 10,
            "lon": 20
        },
        "repr": "width"
    },
    "layers": 1,
    "iters": 1,
    "aggregate_lat": "none",
    "aggregate_level": "none",
    "temp_src": "arrhenius",
    "humidity_src": "arrhenius",
    "albedo_src": "landmask",
    "absorbance_src": "modern",
    "pressure_src": "ncar",
    "scale": [-0.2, 0.2]
}
